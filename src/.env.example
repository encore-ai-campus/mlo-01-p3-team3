# Copy this file to src/interior_recommender/.env and fill in the key. The MVP loads it automatically.
GEMINI_API_KEY=
AI_ANALYSIS_MODEL=gemini-3.5-flash-lite
AI_IMAGE_PROVIDER=cloudflare
AI_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
AI_OUTPUT_WIDTH=512
AI_OUTPUT_HEIGHT=512
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSION=768
AI_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=3
# Optional shared server-to-server token for the RoomPick Canvas bridge
MVP_BRIDGE_TOKEN=
